# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
/frontend/node_modules
/frontend/.pnp
/frontend/.pnp.js
/frontend/yarn/install-state.gz

# testing
/frontend/coverage

# next.js
/frontend/.next/
/frontend/out/
/frontend/next-env.d.ts

# production
/frontend/build

# typescript
/frontend/*.tsbuildinfo

# ---------------------------------------------------------------------------
# Backend (FastAPI / Python)
# ---------------------------------------------------------------------------
/backend/.venv
/backend/venv
/backend/__pycache__/
/backend/**/*.py[cod]
/backend/.pytest_cache/
/backend/.ruff_cache/
/backend/.mypy_cache/
/backend/.coverage
/backend/htmlcov/

# sqlite runtime databases
/backend/*.db
/backend/*.db-journal
/backend/*.sqlite3

# ---------------------------------------------------------------------------
# Secrets (examples are committed, real env files are not)
# ---------------------------------------------------------------------------
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.*.local

# ---------------------------------------------------------------------------
# Misc / OS
# ---------------------------------------------------------------------------
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
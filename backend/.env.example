# Copy to .env and adjust as needed. Only DATABASE_URL and SECRET_KEY
# really matter for local development.

# sqlite (default)
DATABASE_URL=sqlite+aiosqlite:///./bankdash.db

# postgres alternative - no code changes required
# DATABASE_URL=postgresql+asyncpg://bankdash:bankdash@localhost:5432/bankdash

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Set to "production" when deployed. The app refuses to start if this is
# production and SECRET_KEY is still the published development default.
ENVIRONMENT=development
# REQUIRED in production - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-insecure-secret-change-me

# Comma-separated JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]

# --- auth cookies ---
# Must be true in production (HTTPS). Leave false for local http dev, since
# browsers drop Secure cookies sent over plain http.
COOKIE_SECURE=false
# "lax" works when frontend and API are same-site (localhost:3000 -> :8000).
# A separately hosted frontend is cross-site and needs "none" (with Secure).
# WARNING: "none" also disables the browser's built-in CSRF protection. Pair it
# with a CSRF token or an Origin check, or serve the API same-origin via Next
# rewrites instead. The app refuses to start on none-without-secure.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Short on purpose: an access token cannot be revoked before it expires, so this
# is how long a leak stays usable. The client refreshes silently on a 401, so
# 30 minutes costs users nothing. NOTE: if you copied an older .env that sets
# this, it overrides the app default - lower it or delete the line.
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

DEBUG=false
DB_ECHO=false
